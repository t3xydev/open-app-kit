# =============================================================================
# F-Droid Repo Configuration
# Copy this file to .env and fill in your values.
# This single file drives config.yml, rclone.conf, and the Docker API.
# =============================================================================

# -- Data directory ------------------------------------------------------------
# Docker sets DATA_DIR=/data (single volume). Bare metal defaults to repo root.
# DATA_DIR=.

# -- Hosting mode --------------------------------------------------------------
# Self-host when SELF_HOST=true OR S3 vars are incomplete.
# S3 primary when all S3_* are set and SELF_HOST is unset/false.
# SELF_HOST=true + S3 configured => local primary URL + S3 mirror deploy.
SELF_HOST=true

# -- Repo Identity ------------------------------------------------------------
# Self-host: point at this server's /fdroid/repo
# S3 primary: point at the public bucket/R2 URL
# Railway example:
#   REPO_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}/fdroid/repo"
REPO_NAME="F-Droid Repository"
REPO_DESCRIPTION="Apps distributed via F-Droid."
REPO_URL="http://localhost:8000/fdroid/repo"
REPO_WEB_BASE_URL="http://localhost:8000/packages/"

# -- Signing -------------------------------------------------------------------
# Leave KEYSTORE_PASS / KEY_PASS blank -- init auto-generates a random secret
# (persisted under DATA_DIR/.keystore_pass). Keystore is created on first build.
KEYSTORE_FILE="keystore.p12"
REPO_KEYALIAS="keystore.local"
KEYSTORE_PASS=""
KEY_PASS=""
KEYDNAME="CN=keystore.local, OU=F-Droid"

# -- Webhooks ------------------------------------------------------------------
# Required for POST /hooks/apk and POST /hooks/publish
WEBHOOK_TOKEN=""
# EAS Build webhook (POST /hooks/eas). Must match `eas webhook:create --secret`.
# Falls back to WEBHOOK_TOKEN if unset.
EAS_WEBHOOK_SECRET=""

# -- S3 / rclone ---------------------------------------------------------------
# Leave access keys blank for self-host-only. Fill all required fields for
# S3 deploy (and S3-primary when SELF_HOST is not true).
S3_REMOTE_NAME="fdroid-repo"
S3_PROVIDER="Cloudflare"
S3_BUCKET="fdroid-repo"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""

# -- Notifications (Apprise) -------------------------------------------------
# Apprise configuration URL (file path, file://, or https://). Leave blank to disable.
# See: https://github.com/caronc/apprise/wiki/config
# Recommended: store secrets in /data/apprise.yml on the volume (not in git).
# Examples:
#   /data/apprise.yml
#   https://apprise.example.com/get/YOUR_KEY
APPRISE_CONFIG_URL=""
